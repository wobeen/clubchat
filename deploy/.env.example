# 서버의 /opt/itda/.env 로 복사해 채운다. 절대 커밋하지 않는다.

# 배포 도메인 (Caddy 가 자동 HTTPS 인증서를 받는다)
DOMAIN=

# Lightsail 관리형 PostgreSQL 사설 연결 문자열
# 예: postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=no-verify  (TLS 주의사항은 docs/deploy.md 참고)
DATABASE_URL=

# 허용 Origin. https://<DOMAIN> 과 정확히 일치해야 한다.
APP_ORIGIN=

# 세션 서명 키 (32바이트 이상). 예: openssl rand -hex 32
SESSION_SECRET=

# 카카오 로그인
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 예: https://<DOMAIN>/v1/auth/kakao/callback
KAKAO_REDIRECT_URI=

# 운영에서는 설정 금지: AUTH_DEV_LOGIN=1 이면 NODE_ENV=production 서버가 시작을 거부한다.
# 비워 두거나 이 줄 자체를 넣지 않는다.
AUTH_DEV_LOGIN=

# 기본 8080 (compose 가 8080 으로 고정한다)
PORT=

# docker compose 가 쓰는 이미지 태그(배포 워크플로가 설정한다). 롤백 시 이전 태그로 바꾼다.
TAG=
