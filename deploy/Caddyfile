# DOMAIN 환경 변수(예: itda.example.com)로 자동 HTTPS(Let's Encrypt)를 켠다.
{$DOMAIN} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		# server.mjs 의 CSP 와 동일
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob: data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Cache-Control "no-store"
	}

	# API (WebSocket 업그레이드는 reverse_proxy 가 기본 처리한다)
	handle /v1/* {
		reverse_proxy api:8080 {
			# 업스트림 응답 헤더가 보안 헤더를 덮지 않게 하되 Cache-Control 은 API 가 정한다.
			header_down -Server
		}
	}

	handle /health {
		respond `{"status":"ok","app":"itda"}` 200
	}

	# 정적 파일. server.mjs 의 라우트와 같은 결과.
	handle {
		root * /srv/public
		@android path /android /android/
		rewrite @android /index.html
		rewrite /preview /preview.html
		file_server
	}
}
