{
  "expo": {
    "name": "ClubChat",
    "slug": "clubchat",
    "version": "1.0.0",
    "scheme": "clubchat",
    "experiments": {
      "typedRoutes": true
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "ClubChat",
      "shortName": "ClubChat",
      "description": "동아리·소모임을 위한 업무용 메신저",
      "themeColor": "#4A90D9",
      "backgroundColor": "#F3F4F6",
      "lang": "ko",
      "scope": "/",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "ClubChat가 이미지를 공유하려면 사진 라이브러리 접근이 필요합니다.",
          "cameraPermission": "ClubChat가 사진을 찍으려면 카메라 접근이 필요합니다."
        }
      ],
      "expo-document-picker"
    ]
  }
}
