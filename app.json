{
  "expo": {
    "name": "ClubChat",
    "slug": "clubchat",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "scheme": "clubchat",
    "experiments": {
      "typedRoutes": true
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clubchat.app",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "ClubChat가 새 메시지와 일정 알림을 보내려면 알림 권한이 필요합니다."
      }
    },
    "android": {
      "package": "com.clubchat.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "ClubChat",
      "shortName": "ClubChat",
      "description": "동아리·소모임을 위한 업무용 메신저",
      "themeColor": "#4A90D9",
      "backgroundColor": "#F3F4F6",
      "lang": "ko",
      "scope": "/",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "ClubChat가 이미지를 공유하려면 사진 라이브러리 접근이 필요합니다.",
          "cameraPermission": "ClubChat가 사진을 찍으려면 카메라 접근이 필요합니다."
        }
      ],
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "color": "#4A90D9",
          "iosDisplayInForeground": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
